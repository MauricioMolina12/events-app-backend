{
  "name": "events",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend de registro, codigos QR y asignacion de turnos para eventos de Barby Toys y Cupidos",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --env production",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "pretypecheck": "npm run cf-typegen",
    "typecheck": "tsc --noEmit && tsc -p tests/tsconfig.json --noEmit",
    "pretest": "npm run cf-typegen",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply events-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply events-db --env production --remote",
    "db:seed:local": "wrangler d1 execute events-db --local --file=./src/db/seeds/dev.sql"
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.6.3",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.6",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.147.0"
  }
}